# ---- Required --------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
# rediss:// (TLS, e.g. Upstash) works as-is; do not rewrite the scheme.
REDIS_URL=redis://redis:6379/0

# ---- CORS ------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,https://scrybe.example.com

# ---- Storage (reports, vector indexes, source video) -----------------------
# "local": fine for docker-compose (shared volume) and single-service Render.
# "s3": required when API and workers run on different machines (any S3-compatible store).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/data/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=          # e.g. https://<account>.r2.cloudflarestorage.com
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
RETAIN_SOURCE_VIDEO=false   # delete the downloaded video once processing succeeds

# ---- YouTube ingestion -----------------------------------------------------
YOUTUBE_MAX_CONCURRENT_DOWNLOADS=1   # cluster-wide, enforced in Redis
YOUTUBE_MIN_REQUEST_DELAY=5          # seconds between yt-dlp runs, cluster-wide
YOUTUBE_MAX_RETRIES=3
YOUTUBE_COOLDOWN_SECONDS=300         # pause ALL workers after a 429 / bot-check
# PO Token provider (bgutil HTTP server). Empty = plugin default http://127.0.0.1:4416
# BGUTIL_BASE_URL=http://bgutil:4416
# Dedicated egress you control (NOT a free proxy list). Empty = direct.
# YTDLP_PROXY=
# Last resort only; see docs/youtube-ingestion.md. Never commit this file.
# YTDLP_COOKIES_FILE=

# ---- Abuse limits (per client, shared across API instances via Redis) ------
API_RATE_LIMIT=60                # requests / minute
MAX_VIDEO_JOBS_PER_USER=20       # submissions / 24h
MAX_ACTIVE_JOBS_PER_USER=3
TRUST_FORWARDED_FOR=true         # set false if the API is reachable without a trusted proxy

# ---- Ask Scrybe ------------------------------------------------------------
ANSWER_CACHE_TTL_SECONDS=3600    # 0 disables the answer cache
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25         # calibrated for MiniLM; re-tune if you change embedder
# LLM_PRICES=openai/gpt-oss-120b:0.15:0.60   # optional $/1M tokens "model:in:out,..." for cost *estimates*

# ---- Worker selection (worker_entrypoint.sh) -------------------------------
# CELERY_QUEUES=youtube_ingestion,video_processing,embeddings,ai_tasks,reports
# CELERY_CONCURRENCY=2
